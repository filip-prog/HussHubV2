-- ============ LISTENERS ============
-- Journey State
JourneyEvent.OnClientEvent:Connect(function(action, data)
    if action == "State" and type(data) == "table" then
        if CONFIG.AutoClaimJourney and data.message ~= "All available rewards collected." then
            task.delay(2, function()
                pcall(function() JourneyEvent:FireServer("ClaimAll", nil, "season_1") end)
            end)
        end
    end
end)

-- Map Vote State
if MapVoteState and MapVoteState:IsA("StringValue") then
    local function readMapVoteState()
        local ok, state = pcall(function()
            return HttpService:JSONDecode(MapVoteState.Value)
        end)
        if ok and type(state) == "table" then
            State.mapVotePhase = tostring(state.phase or "Waiting")
            State.mapVoteToken = state.token
            if CONFIG.AutoMapVote and State.mapVotePhase == "Voting" and State.mapVoteToken then
                task.delay(1, function()
                    pcall(function()
                        MapVoteEvent:FireServer("Vote", CONFIG.MapVoteSelection, State.mapVoteToken)
                    end)
                end)
            end
        end
    end
    readMapVoteState()
    MapVoteState.Changed:Connect(readMapVoteState)
end

